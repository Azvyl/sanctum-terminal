# Sanctum Terminal - Node & System Configuration

# ==========================================
# Node Identification & Services
# ==========================================
# Unique machine identifier for distributed election & telemetry (e.g., vps, realme, asus)
NODE_ID=vps

# Human-readable device name for telemetry and UI
NODE_NAME=VPS

# Comma-separated list of services this node is capable of running:
# Available options: discord_bot, discord_widgets, stream_bridge
ENABLED_SERVICES=discord_bot,discord_widgets,stream_bridge

# Failover Priority Lists (comma-separated node IDs in order of leadership priority)
SERVICE_PRIORITY_DISCORD_BOT=vps,realme
SERVICE_PRIORITY_DISCORD_WIDGETS=vps,realme
SERVICE_PRIORITY_STREAM_BRIDGE=vps,asus

# Debug logging (true | false)
DEBUG=false

# ==========================================
# Firebase Realtime Database
# ==========================================
FIREBASE_DB_URL=https://your-firebase-project-default-rtdb.firebasedatabase.app
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Node Authentication
FIREBASE_AUTH_EMAIL=vps@sanctum.internal
FIREBASE_AUTH_PASSWORD=your_secure_device_password

# ==========================================
# Primary Discord Credentials
# ==========================================
DISCORD_BOT_TOKEN=your_primary_bot_token
DISCORD_BOT_APPLICATION_ID=your_discord_client_id
DISCORD_OWNER_USER_ID=your_discord_user_id

# ==========================================
# Discord Bot Presence & Rotation
# ==========================================
DISCORD_BOT_ACTIVITIES=[{"name":"Azvylia Nekonova","type":"Watching","durationSeconds":177},{"name":"Custom Status","type":"Custom","state":"Kyoyama Kazusa Bot","durationSeconds":3}]
DISCORD_BOT_ACTIVITY_INTERVAL_SECONDS=30

